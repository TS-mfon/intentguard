{
  "openapi": "3.1.0",
  "info": {
    "title": "IntentGuard agent spending API",
    "version": "0.1.0",
    "description": "Owner-approved X Layer spending cards, TapeOut reservation and finalized GenLayer evidence review."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/config": {
      "get": {
        "operationId": "getConfig",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/challenge": {
      "post": {
        "operationId": "walletChallenge",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "address": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  }
                },
                "required": [
                  "address"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "walletLogin",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "address": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{40}$"
                    }
                  },
                  "required": [
                    "address"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "address": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "signature": {
                    "type": "string"
                  }
                },
                "required": [
                  "address",
                  "signature"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "walletSession",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "address": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^0x[0-9a-fA-F]{40}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "address"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "walletLogout",
        "security": [
          {
            "OwnerSession": []
          }
        ],
        "responses": {
          "204": {
            "description": "Success"
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/owner/drafts": {
      "post": {
        "operationId": "createDraft",
        "security": [
          {
            "OwnerSession": []
          }
        ],
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{64}$"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 12000
                  },
                  "guidance": {
                    "type": "object"
                  }
                },
                "required": [
                  "description"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/owner/drafts/{id}": {
      "get": {
        "operationId": "getDraft",
        "security": [
          {
            "OwnerSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftView"
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/owner/cards": {
      "get": {
        "operationId": "listCards",
        "security": [
          {
            "OwnerSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cards": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CardView"
                      }
                    }
                  },
                  "required": [
                    "cards"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "registerCard",
        "security": [
          {
            "OwnerSession": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "card": {
                      "$ref": "#/components/schemas/CardView"
                    }
                  },
                  "required": [
                    "card"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "draftId": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  },
                  "cardAddress": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "activationTx": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  }
                },
                "required": [
                  "draftId",
                  "cardAddress",
                  "activationTx"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/owner/cards/{id}/keys": {
      "post": {
        "operationId": "issueAgentKey",
        "security": [
          {
            "OwnerSession": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apiKey": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "apiKey"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "delete": {
        "operationId": "revokeAgentKeys",
        "security": [
          {
            "OwnerSession": []
          }
        ],
        "responses": {
          "204": {
            "description": "Success"
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/owner/requests": {
      "get": {
        "operationId": "listOwnerRequests",
        "security": [
          {
            "OwnerSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "requests": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RequestView"
                      }
                    }
                  },
                  "required": [
                    "requests"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/owner/requests/{id}": {
      "get": {
        "operationId": "getOwnerRequest",
        "security": [
          {
            "OwnerSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestView"
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "agentCard",
        "security": [
          {
            "AgentKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "card": {
                      "$ref": "#/components/schemas/CardView"
                    }
                  },
                  "required": [
                    "card"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/requests": {
      "post": {
        "operationId": "requestMerchantPayment",
        "security": [
          {
            "AgentKey": []
          }
        ],
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{64}$"
                    },
                    "status": {
                      "enum": [
                        "QUEUED",
                        "RESERVED",
                        "REVIEWING",
                        "AWAITING_FINALITY",
                        "APPROVED",
                        "PAID",
                        "BLOCKED",
                        "REJECTED",
                        "NEEDS_EVIDENCE",
                        "EXPIRED",
                        "CANCELLED",
                        "RETRYING"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Reuse for identical payment details; conflicting content returns HTTP 409."
          }
        ]
      }
    },
    "/requests/{id}": {
      "get": {
        "operationId": "getAgentRequest",
        "security": [
          {
            "AgentKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestView"
                }
              }
            }
          },
          "default": {
            "description": "Structured API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AgentKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "ig_<random key>"
      },
      "OwnerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ig_session"
      }
    },
    "schemas": {
      "Policy": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "const": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "mission": {
            "type": "string",
            "minLength": 3,
            "maxLength": 4000
          },
          "taskContext": {
            "type": "string",
            "maxLength": 6000
          },
          "allowedCategories": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "prohibitedPurchases": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "exceptions": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "financial": {
            "type": "object",
            "properties": {
              "totalBudget": {
                "type": "string"
              },
              "perPaymentLimit": {
                "type": "string"
              },
              "periodBudget": {
                "type": "string"
              },
              "periodSeconds": {
                "type": "integer",
                "minimum": 60,
                "maximum": 31536000
              },
              "validFrom": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "validUntil": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "totalBudget",
              "perPaymentLimit",
              "periodBudget",
              "periodSeconds",
              "validFrom",
              "validUntil"
            ],
            "additionalProperties": false
          },
          "merchants": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "recipient": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                },
                "origins": {
                  "minItems": 1,
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri"
                  }
                },
                "products": {
                  "maxItems": 30,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              },
              "required": [
                "name",
                "recipient",
                "origins",
                "products"
              ],
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "object",
            "properties": {
              "requiredTypes": {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "approvedOrigins": {
                "minItems": 1,
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 2048,
                  "format": "uri"
                }
              },
              "maxAgeSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 31536000
              }
            },
            "required": [
              "requiredTypes",
              "approvedOrigins",
              "maxAgeSeconds"
            ],
            "additionalProperties": false
          },
          "criteria": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,40}$"
                },
                "description": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 1000
                }
              },
              "required": [
                "id",
                "description"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "version",
          "name",
          "mission",
          "taskContext",
          "allowedCategories",
          "prohibitedPurchases",
          "exceptions",
          "financial",
          "merchants",
          "evidence",
          "criteria"
        ],
        "additionalProperties": false
      },
      "PaymentInput": {
        "type": "object",
        "properties": {
          "recipient": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "amount": {
            "type": "string"
          },
          "purchaseDescription": {
            "type": "string",
            "minLength": 3,
            "maxLength": 2000
          },
          "justification": {
            "type": "string",
            "minLength": 3,
            "maxLength": 6000
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "invoiceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "evidence": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "format": "uri"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^(0x)?[0-9a-fA-F]{64}$"
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "recipient",
          "amount",
          "purchaseDescription",
          "justification",
          "category",
          "invoiceId",
          "evidence"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "ReviewDecision": {
        "type": "object",
        "properties": {
          "decision": {
            "enum": [
              "APPROVE",
              "REJECT",
              "NEEDS_EVIDENCE"
            ]
          },
          "requestHash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "policyHash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "evidenceHash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "INSUFFICIENT"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "status",
