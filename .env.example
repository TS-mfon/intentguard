# Web + worker shared public configuration. Keep live mode for X Layer 196 USDT.
INTENTGUARD_MODE=live
APP_URL=http://localhost:3000
XLAYER_RPC_URL=https://rpc.xlayer.tech
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=intentguard
SESSION_SECRET=
CARD_FACTORY_ADDRESS=
GATEWAY_ADDRESS=
ATTESTOR_ADDRESS=
TAPEOUT_PROCESSOR=
TAPEOUT_CIRCUIT_ID=
TAPEOUT_BEACON=0xf70d1ed4f62CF3780157B0b421b7E2F45bD0991C
TAPEOUT_IMPLEMENTATION=
TAPEOUT_NETLIST_HASH=0x280890411f873d9cf1e113c5edf783c18b14d4f9485c567a7d0ec2d45292a761
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_INTERPRETER_ADDRESS=
# Worker-only dedicated secrets. Never expose these to a browser.
XLAYER_OPERATOR_PRIVATE_KEY=
REVIEW_ATTESTOR_PRIVATE_KEY=
GENLAYER_OPERATOR_PRIVATE_KEY=
# Deployment-only signer; scripts never generate or reuse an unrelated wallet.
DEPLOYER_PRIVATE_KEY=
# Optional demo merchant. Point DEMO_MERCHANT_URL to its public HTTPS deployment.
DEMO_MERCHANT_URL=
DEMO_MERCHANT_ADMIN_KEY=
DEMO_MERCHANT_RECIPIENT=
# Local isolated tests only; do not set these for live mode.
# XLAYER_CHAIN_ID=31337
# PAYMENT_TOKEN=<local six-decimal test token>

# Hosted testnet: INTENTGUARD_MODE=testnet; XLAYER_CHAIN_ID=1952;
# PAYMENT_TOKEN=<deployed TEST-USDT>; XLAYER_RPC_URL=https://testrpc.xlayer.tech
# Vercel-hosted immutable invoice creation uses the merchant admin key/recipient above.

# Server-only GitHub Actions wake configuration; never use NEXT_PUBLIC_ names.
# Token requires Actions read/write for this repository. Worker uses github.token.
GITHUB_WORKER_TOKEN=
GITHUB_WORKER_REPOSITORY=
GITHUB_WORKER_WORKFLOW=worker.yml
GITHUB_WORKER_REF=main
