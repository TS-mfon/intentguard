# Explicit testnet profile; existing testnet data is preserved.
INTENTGUARD_MODE=testnet
INTENTGUARD_PAYMENT_ENV=testnet
XLAYER_CHAIN_ID=1952
APP_URL=http://localhost:3000
XLAYER_RPC_URL=https://testrpc.xlayer.tech
PAYMENT_TOKEN=
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=intentguard
SESSION_SECRET=
CARD_FACTORY_ADDRESS=
CCTP_CARD_FACTORY_ADDRESS=
GATEWAY_ADDRESS=
ATTESTOR_ADDRESS=
TAPEOUT_PROCESSOR=
TAPEOUT_CIRCUIT_ID=
TAPEOUT_BEACON=
TAPEOUT_IMPLEMENTATION=
TAPEOUT_NETLIST_HASH=0x280890411f873d9cf1e113c5edf783c18b14d4f9485c567a7d0ec2d45292a761
GENLAYER_NETWORK=studionet
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_INTERPRETER_ADDRESS=
# Worker-only secrets, never NEXT_PUBLIC_ variables.
XLAYER_OPERATOR_PRIVATE_KEY=
REVIEW_ATTESTOR_PRIVATE_KEY=
GENLAYER_OPERATOR_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
DEMO_MERCHANT_URL=
DEMO_MERCHANT_ADMIN_KEY=
DEMO_MERCHANT_RECIPIENT=
GITHUB_WORKER_TOKEN=
GITHUB_WORKER_REPOSITORY=
GITHUB_WORKER_WORKFLOW=worker.yml
GITHUB_WORKER_REF=main
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# New mainnet deployment uses a separate secret/configuration set:
# INTENTGUARD_MODE=mainnet
# INTENTGUARD_PAYMENT_ENV=mainnet
# XLAYER_CHAIN_ID=196
# XLAYER_RPC_URL=https://rpc.xlayer.tech
# APP_URL=https://<canonical-mainnet-api-origin>
# MONGODB_DB=intentguard_mainnet
# MONGODB_URI=mongodb+srv://intentguard_mainnet_api:<separate-password>@<cluster>/intentguard_mainnet
# Actions uses intentguard_mainnet_worker instead of the API principal.
# PAYMENT_TOKEN=0x779ded0c9e1022225f8e0630b35a9b54be713736
# Mainnet gateway, attestor, reviewer operator, session secret and merchant keys
# must be independent of testnet. Gateway and attestor must be distinct.
# GENLAYER_NETWORK=studionet
# GENLAYER_RPC_URL=https://studio.genlayer.com/api
# GENLAYER_GENESIS_HASH=<verified Studionet block-zero hash>
# GENLAYER_CONSENSUS_ADDRESS=0xb7278a61aa25c888815afc32ad3cc52ff24fe575
# INTENTGUARD_RELEASE_ID=<immutable deployment identity>
# INTENTGUARD_SOURCE_COMMIT=<full40hex commit>
# INTENTGUARD_VERIFIED_MANIFEST=<repository-relative verified manifest path>
# INTENTGUARD_VERIFIED_MANIFEST_SHA256=<64hex digest of that file>
# All contract addresses/pins above belong to the new deployment.
# Mainnet remains unconfigured until these gates exist.
# No official GenLayer mainnet is claimed: semantic review runs on testnet.

# Local tests use explicit INTENTGUARD_MODE=local, INTENTGUARD_PAYMENT_ENV=local,
# XLAYER_CHAIN_ID=31337 and MONGODB_DB=intentguard_local.
# A build with no explicit profile renders an unconfigured local application.
# Dedicated bootstrap credentials are never provided to API/worker processes:
# MAINNET_DATABASE_ADMIN_URI=
# INTENTGUARD_DATABASE_BOOTSTRAP_APPROVAL=<reviewed release identity>


# Separate static frontend: APP_URL is the canonical API origin.
# FRONTEND_URL=https://<approved-tapekit-frontend-origin>
# NEXT_PUBLIC_INTENTGUARD_API_ORIGIN=https://<canonical-api-origin>
# NEXT_PUBLIC_INTENTGUARD_PAYMENT_ENV=mainnet
# NEXT_PUBLIC_INTENTGUARD_SOURCE_COMMIT=<exact source commit>
# These NEXT_PUBLIC values are public build pins, never keys or connection strings.
# Cross-origin owner sessions expire after ten minutes and stay in browser memory.
